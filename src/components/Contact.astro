<section class="contact reveal" id="rifugio">
  <div class="contact__header">
    <p class="section-label">Vieni a Trovarci</p>
    <h2 class="section-title">Il Rifugio</h2>
  </div>

  <div class="contact__grid">
    <!-- Left: Orari -->
    <div class="reveal--left">
      <h3 style="font-family:var(--font-display);font-size:1.3rem;margin-bottom:var(--space-lg);">Orari di Apertura</h3>

      <div class="contact__schedule">
        <div class="schedule-row schedule-row--highlight">
          <span class="schedule-row__day">Luned&igrave;</span>
          <span class="schedule-row__hours">19:30 &ndash; 00:00</span>
        </div>

        <div class="schedule-row schedule-row--closed">
          <span class="schedule-row__day">Marted&igrave;</span>
          <span class="schedule-row__hours">CHIUSO</span>
        </div>

        <div class="schedule-row">
          <span class="schedule-row__day">Mercoled&igrave;</span>
          <span class="schedule-row__hours">19:30 &ndash; 00:00</span>
        </div>

        <div class="schedule-row">
          <span class="schedule-row__day">Gioved&igrave;</span>
          <span class="schedule-row__hours">19:30 &ndash; 00:00</span>
        </div>

        <div class="schedule-row schedule-row--highlight">
          <span class="schedule-row__day">Venerd&igrave;</span>
          <span class="schedule-row__hours">12:30 &ndash; 15:00 | 19:30 &ndash; 00:00</span>
        </div>

        <div class="schedule-row schedule-row--highlight">
          <span class="schedule-row__day">Sabato</span>
          <span class="schedule-row__hours">12:30 &ndash; 15:00 | 19:30 &ndash; 00:00</span>
        </div>

        <div class="schedule-row schedule-row--highlight">
          <span class="schedule-row__day">Domenica</span>
          <span class="schedule-row__hours">12:30 &ndash; 15:00 | 19:30 &ndash; 00:00</span>
        </div>
      </div>

      <div class="contact__info">
        <div class="contact__address">
          <strong>Trattoria Dei Cacciatori</strong><br />
          Via dei Laghi, 187<br />
          00049 Velletri RM<br />
          <span style="color:var(--slate);font-size:var(--text-xs);">Plus Code: 8FHJM2F6+HQ</span>
        </div>

        <a href="https://wa.me/390639630945" class="contact__wa-btn" target="_blank" rel="noopener">
          <svg viewBox="0 0 24 24" width="20" height="20" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
          Prenota via WhatsApp
        </a>
      </div>
    </div>

    <!-- Right: Mappa -->
    <div class="reveal--right">
      <div class="contact__map-wrapper" id="map"></div>

      <a href="https://www.google.com/maps/dir/?api=1&destination=41.7011544,12.7619578"
         class="nav__wa"
         target="_blank" rel="noopener"
         style="display:inline-flex;align-items:center;gap:var(--space-sm);margin-top:var(--space-lg);padding:0.7rem 1.5rem;">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="stroke:var(--birch);"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 5.4 8 14 8 14s8-8.6 8-14a8 8 0 0 0-8-8z"/></svg>
        Portami l&igrave;
      </a>
    </div>
  </div>
</section>
