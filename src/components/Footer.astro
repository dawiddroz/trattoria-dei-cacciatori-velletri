<footer class="footer">
  <div class="footer__inner">
    <!-- Decorative double line -->
    <div class="footer__decor" aria-hidden="true"></div>

    <!-- Top: brand + nav -->
    <div class="footer__top">
      <div class="footer__brand-group">
        <span class="footer__brand">Trattoria Dei Cacciatori</span>
        <span class="footer__tagline">di Bagaglini Giacinto &mdash; dal 1970</span>
      </div>
      <nav class="footer__nav" aria-label="Navigazione footer">
        <a href="#storia">La Tradizione</a>
        <a href="#menu">Menu</a>
        <a href="#recensioni">Recensioni</a>
        <a href="#rifugio">Contatti</a>
      </nav>
    </div>

    <!-- Bottom: address + info + credits -->
    <div class="footer__bottom">
      <div class="footer__address">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="var(--copper)" stroke-width="2"><circle cx="12" cy="10" r="3"/><path d="M12 2a8 8 0 0 0-8 8c0 5.4 8 14 8 14s8-8.6 8-14a8 8 0 0 0-8-8z"/></svg>
        <span>Via dei Laghi, 187 &mdash; 00049 Velletri RM</span>
      </div>
      <div class="footer__info">
        <a href="tel:+390639630945" class="footer__tel">06 963 0945</a>
        <span class="footer__sep">|</span>
        <a href="https://wa.me/390639630945" class="footer__wa" target="_blank" rel="noopener">WhatsApp</a>
      </div>
      <span class="footer__credits">&copy; 1970 &ndash; 2026 Bagaglini Giacinto</span>
    </div>
  </div>
</footer>
