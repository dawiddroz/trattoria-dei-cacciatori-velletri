<section class="hero" id="home">
  <div class="hero__content">
    <!-- Decorative tree rings background -->
    <svg class="hero__rings" viewBox="0 0 600 600" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">
      <circle cx="300" cy="300" r="280" class="rings-circle-1" />
      <circle cx="300" cy="300" r="240" class="rings-circle-2" />
      <circle cx="300" cy="300" r="190" class="rings-circle-3" />
      <circle cx="300" cy="300" r="150" class="rings-circle-4" />
      <circle cx="300" cy="300" r="115" class="rings-circle-5" />
      <circle cx="300" cy="300" r="85" class="rings-circle-6" />
      <circle cx="300" cy="300" r="60" class="rings-circle-7" />
    </svg>

    <h1 class="hero__title">
      Trattoria<br />Dei&nbsp;<em>Cacciatori</em>
    </h1>
    <p class="hero__subtitle">
      Tradizione, cacciagione e genuinit&agrave; dal 1970. Pasta fatta a mano,
      funghi porcini e il calore della famiglia Bagaglini.
    </p>
    <div class="hero__rating">
      <span class="hero__stars" aria-label="4.3 stelle su 5">&#9733;&#9733;&#9733;&#9733;&#9734;</span>
      <span>4.3 &mdash; 834 recensioni su Google</span>
    </div>
    <a href="https://wa.me/390639630945" class="hero__cta" target="_blank" rel="noopener">
      <svg viewBox="0 0 24 24" width="18" height="18" fill="currentColor"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347"/></svg>
