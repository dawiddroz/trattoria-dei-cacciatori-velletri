  </div>

  <div class="hero__image-wrapper">
    <img
      class="hero__image"
      src="https://images.unsplash.com/photo-1414235077428-338989a2e8c0?w=1200&q=85&auto=format&fit=crop"
      alt="Ristorante accogliente con tavoli in legno e luce calda"
      loading="eager"
      onerror="this.src='https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1200&q=85&auto=format&fit=crop'"
    />
    <div class="hero__copper-line"></div>
  </div>
</section>
