<section class="menu reveal" id="menu">
  <div class="menu__header">
    <p class="section-label">Le Nostre Specialit&agrave;</p>
    <h2 class="section-title">La Foresta in Tavola</h2>
  </div>

  <div class="menu__grid">
    <!-- Card 1 — Large -->
    <article class="menu__card menu__card--large reveal--scale">
      <div class="menu__img-wrapper">
        <img
          class="menu__img"
          src="https://images.unsplash.com/photo-1621996346565-e3dbc646d9a9?w=800&q=85&auto=format&fit=crop"
          alt="Fettuccine al cinghiale"
          loading="lazy"
          onerror="this.src='https://images.unsplash.com/photo-1645112411341-6c4fd023882c?w=800&q=85&auto=format&fit=crop'"
        />
      </div>
      <h3 class="menu__name">Fettuccine al Cinghiale</h3>
      <p class="menu__desc">Pasta all&rsquo;uovo fatta a mano, rag&ugrave; di cinghiale, pecorino, erbe aromatiche</p>
      <span class="menu__price">&euro;12</span>
    </article>

    <!-- Card 2 — Small -->
    <article class="menu__card menu__card--small reveal--scale">
      <div class="menu__img-wrapper">
        <img
          class="menu__img"
          src="https://images.unsplash.com/photo-1544025162-d76694265947?w=600&q=85&auto=format&fit=crop"
          alt="Antipasto misto della casa"
          loading="lazy"
          onerror="this.src='https://images.unsplash.com/photo-1626200419199-391ae4be7a41?w=600&q=85&auto=format&fit=crop'"
        />
      </div>
      <h3 class="menu__name">Antipasto Misto</h3>
      <p class="menu__desc">Salumi, formaggi, verdure grigliate, bruschetta</p>
      <span class="menu__price">&euro;14</span>
    </article>

    <!-- Card 3 — Medium -->
    <article class="menu__card reveal--scale">
      <div class="menu__img-wrapper">
        <img
          class="menu__img"
          src="https://images.unsplash.com/photo-1432139555190-58524dae6a55?w=700&q=85&auto=format&fit=crop"
          alt="Tagliata di manzo ai funghi porcini"
          loading="lazy"
          onerror="this.src='https://images.unsplash.com/photo-1546833998-877b37c2e5c6?w=700&q=85&auto=format&fit=crop'"
        />
      </div>
      <h3 class="menu__name">Tagliata ai Porcini</h3>
      <p class="menu__desc">Carne scelta, funghi porcini freschi, rosmarino, olio EVO</p>
      <span class="menu__price">&euro;22</span>
    </article>
  </div>

  <div style="text-align:center;margin-top:var(--space-3xl);">
    <a href="https://wa.me/390639630945" class="menu__cta" target="_blank" rel="noopener">
      Scopri il menu completo
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M12 5l7 7-7 7"/></svg>
    </a>
  </div>
</section>
